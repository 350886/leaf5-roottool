# ── 打包产物 ────────────────────────────────────────────────────────
dist/
build/work/
*.exe
*.dll

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 第三方二进制，不进仓库 ──────────────────────────────────────────
# 来源与 sha256 见 README「assets 里的二进制不进仓库」那张表。
# 少了这几个 build.py 会直接报路径，不会打出半成品。
assets/adb/
assets/magisk/
assets/zadig.exe
assets/*.bin
assets/payload/preload.so

# ── 备份 / 中间产物 ─────────────────────────────────────────────────
_bak_*/
*.orig
*.orig2
*.orig3
*.bak_*
*.bak
roottool.py.bak_before_safety

# ── 测试现场（只留两个可复跑的脚本）────────────────────────────────
_test_dump/adb_side/
_test_dump/edl_side/
_test_dump/edl_side2/
_test_dump/edl_side3/
_test_dump/edl_side4/
_test_dump/build/
_test_dump/*.img
_test_dump/*.txt
_test_dump/mock_*.py
