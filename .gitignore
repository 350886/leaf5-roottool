# ── 打包产物 ────────────────────────────────────────────────────────
dist/
*.exe
*.dll

# PyInstaller 的工作目录：spec、version_info.txt、中间树、gp_ui.on 标记，
# 全部由 build.py 每次现场生成，里面还带本机绝对路径，没有跟踪价值。
# 跟踪它们的结果是「跑一次 build.py 工作区就脏」，谁也不知道该提交什么。
build/

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 第三方二进制，不进仓库 ──────────────────────────────────────────
# 来源与 sha256 见 README「assets 里的二进制不进仓库」那张表。
# 少了这几个 build.py 会直接报路径，不会打出半成品。
# 目录本身留着（.gitkeep），省得 clone 下来还要先 mkdir。
assets/adb/*
!assets/adb/.gitkeep
assets/magisk/*
!assets/magisk/.gitkeep
assets/zadig.exe
assets/*.bin
assets/payload/preload.so
# 商店 APK 64 MB，同一个道理不进仓库。build.py 找不到会直接报路径；
# 只出普通版不受影响（--no-gp）。
assets/apk/*
!assets/apk/.gitkeep

# ── 备份 / 中间产物 ─────────────────────────────────────────────────
_bak_*/
*.orig
*.orig2
*.orig3
*.bak_*
*.bak
roottool.py.bak_before_safety

# ── 测试现场（只留两个可复跑的脚本）────────────────────────────────
_test_dump/adb_side/
_test_dump/edl_side/
_test_dump/edl_side2/
_test_dump/edl_side3/
_test_dump/edl_side4/
_test_dump/build/
_test_dump/*.img
_test_dump/*.txt
_test_dump/mock_*.py
